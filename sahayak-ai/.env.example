# Copy to .env in this folder (sahayak-ai/.env)

# Backend (Node)
PORT=5000
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# Optional: Python OCR service URL (FastAPI on port 8000)
AI_SERVICE_URL=http://127.0.0.1:8000

# Optional: override path to schemes JSON
# SCHEMES_PATH=

# Frontend (Vite) — leave unset to use http://localhost:5000 in the browser
# VITE_API_URL=http://localhost:5000
